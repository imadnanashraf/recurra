{
  "appId": "app.recurra",
  "appName": "Recurra",
  "webDir": "www",
  "backgroundColor": "#f4f7fb",
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#2F6F73"
    },
    "PushNotifications": {
      "presentationOptions": []
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "appReadyTimeout": 10000
    },
    "Keyboard": {
      "resizeOnFullScreen": true
    }
  }
}
