{
  "name": "recurra",
  "version": "2.0.0",
  "private": true,
  "description": "Daily spaced-repetition MCQ review for exams and interviews. Web app and Android app, synced with Firebase.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "android:prepare": "node scripts/build.mjs && npx cap add android && node scripts/patch-android.mjs && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "7.5.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/keyboard": "7.0.6",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/push-notifications": "7.0.7",
    "@capacitor/status-bar": "7.0.6",
    "@capgo/capacitor-updater": "7.51.23",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "firebase": "11.10.0"
  },
  "nativeLevel": 4,
  "devDependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
