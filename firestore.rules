rules_version = '2';
// Who can read and write what. Published automatically by the "Accounts" GitHub job when this file changes.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // the superadmin: this exact email, and it must be verified
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'adnan.ashraf19@gmail.com' && request.auth.token.email_verified == true;
    }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    // an account that is turned off, being deleted or deleted cannot change anything
    function locked(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) && profile(uid).data.get('status', 'active') in ['deleting', 'deleted', 'disabled'];
    }
    // fields only the admin (or the account job) may set
    function adminFields() { return ['status', 'deleteAt', 'deleteRequestedAt', 'disabledAt', 'deletedAt', 'authDisabled', 'test']; }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && !request.resource.data.keys().hasAny(adminFields()));
      // a person may update their profile, and may ask for their own deletion (status "deleting"), nothing else
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && !locked(uid) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminFields()) ||
        (request.resource.data.status == 'deleting' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deleteAt', 'deleteRequestedAt', 'lastSeen', 'lastPlatform', 'lastDevice', 'lastIp', 'lastPlace']))));
      allow delete: if isAdmin();

      // everything under the profile (preps, questions, progress, devices); at least one level down, so the rules above stay in charge of the profile itself
      match /{sub}/{document=**} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && !locked(uid));
      }
    }

    // activity log: anyone signed in can add entries about themselves; only the admin can read them
    match /logs/{id} {
      allow create: if signedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow read, update, delete: if isAdmin();
    }
  }
}
